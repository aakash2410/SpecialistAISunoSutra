# Copy to inventory.ini and adjust for your device.
[specialist]
suno-sutra ansible_user=suno-sutra ansible_python_interpreter=/usr/bin/python3

# Reuse files already downloaded to another folder, for example:
# suno-sutra ansible_user=suno-sutra specialist_assets_dir=/home/suno-sutra/specialist-assets

# A device with the 2.8 inch touch screen: uncomment these two lines so every install,
# whatever its tags, keeps the screen on. Without them the screen is off unless you add
# -e specialist_screen=true to each install command.
# [specialist:vars]
# specialist_screen=true
