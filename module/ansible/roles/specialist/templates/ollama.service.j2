# Installed by the Specialist Ansible role when Ollama came from the Docker image.
# The official install script creates this unit itself.

[Unit]
Description=Ollama Service
After=network-online.target

[Service]
ExecStart=/usr/local/bin/ollama serve
User=ollama
Group=ollama
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
