[Unit]
Description=The Specialist voice loop
# The boot check loads the answer model first, so the first question is not slow.
After=specialist-boot-check.service ollama.service bhashini_models.service sound.target
Wants=specialist-boot-check.service

[Service]
Type=simple
User={{ specialist_user }}
ExecStart=/usr/local/bin/specialist-voice --in-lang {{ specialist_voice_in_lang }} --out-lang {{ specialist_voice_out_lang }}
Environment=PYTHONUNBUFFERED=1
# Set here, not in /etc/default/specialist, so specialist-voice run by hand still uses Enter.
{% if specialist_screen | bool %}
Environment=SPECIALIST_TRIGGER={{ specialist_trigger }},screen
Environment=SPECIALIST_SCREEN=1
Environment=SPECIALIST_SCREEN_ROTATION={{ specialist_screen_rotation }}
{% else %}
Environment=SPECIALIST_TRIGGER={{ specialist_trigger }}
{% endif %}
{% if specialist_voice_poweroff | bool %}
# "Switch off", then a spoken yes, runs sudo -n /usr/bin/systemctl poweroff, which
# /etc/sudoers.d/specialist-poweroff allows. Only this service may switch the device off.
# sudo needs setuid, so do not add NoNewPrivileges=yes or a hardening option that implies it.
Environment=SPECIALIST_ALLOW_POWEROFF=1
{% endif %}
{% if specialist_gpio_chip %}
Environment=SPECIALIST_GPIO_CHIP={{ specialist_gpio_chip }}
Environment=SPECIALIST_GPIO_LINE={{ specialist_gpio_line }}
{% endif %}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
