# Managed by the Specialist Ansible role. Read by the voice loop and the boot check.
SPECIALIST_MIC_DEVICE={{ specialist_mic_device }}
SPECIALIST_ALSA_DEVICE={{ specialist_speaker_device }}
# The device never downloads models at run time, so a missing file fails instead of reaching out.
HF_HUB_OFFLINE=1
# The teacher's everyday examples for the example after an explanation. Edit it, then restart the voice loop.
SPECIALIST_TEACHER_EXAMPLES={{ specialist_root }}/teacher_examples.txt
TRANSFORMERS_OFFLINE=1
{% if specialist_malloc_arena_max %}
# Fewer glibc memory arenas, so the voice loop holds less freed memory. Answers do not change.
MALLOC_ARENA_MAX={{ specialist_malloc_arena_max }}
{% endif %}
