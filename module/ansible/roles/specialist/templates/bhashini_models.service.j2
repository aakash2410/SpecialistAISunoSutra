# Managed by the Specialist Ansible role. Do not edit by hand.
#
# Speech-to-text, translation and speech for Hindi and the other Indic languages.
# main.py listens on 127.0.0.1:11400 only.

[Unit]
Description=Bhashini Models Service
After=network.target

[Service]
User={{ specialist_user }}
Group={{ specialist_user }}
WorkingDirectory={{ specialist_bhashini_dir }}
ExecStart={{ specialist_bhashini_dir }}/venv/bin/python {{ specialist_bhashini_dir }}/main.py
Restart=always

[Install]
WantedBy=multi-user.target
